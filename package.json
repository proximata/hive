{
  "name": "@proximata/hive",
  "productName": "hive",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/proximata/hive.git"
  },
  "homepage": "https://beecomb-relay.exe.xyz",
  "engines": {
    "node": ">=18"
  },
  "version": "0.1.0",
  "description": "A hive mind communication platform on the Pears stack \u2014 Nostr relay, agents, workflows",
  "license": "Apache-2.0",
  "type": "commonjs",
  "upgrade": "pear://replace-with-pear-touch-output",
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "hive": "./bin/hive.js"
  },
  "files": [
    "bin/",
    "bin.mjs",
    "app.js",
    "scripts/bare.js",
    "workers/",
    "packages/hive-agent/",
    "packages/hive-auth/",
    "packages/hive-cli/",
    "packages/hive-core/",
    "packages/hive-relay/",
    "packages/hive-sdk/",
    "packages/hive-store/",
    "packages/hive-workflow/",
    "packages/hive-web/public/",
    "README.md",
    "SECURITY.md"
  ],
  "scripts": {
    "start": "node scripts/bare.js bin.mjs relay --no-updates",
    "test": "node scripts/bare.js test/all.js",
    "lint": "echo \"No linter configured\"",
    "demo": "node scripts/bare.js scripts/demo.js",
    "demo:tui": "node scripts/demo-runner.js",
    "demo:delegation": "node scripts/bare.js scripts/demo-delegation.js",
    "demo:cli": "node scripts/demo-runner.js",
    "make": "node scripts/bare.js scripts/make.js",
    "make:linux-x64": "bare-build --host linux-x64 --standalone --name hive --out out/linux-x64 bin.mjs",
    "make:linux-arm64": "bare-build --host linux-arm64 --standalone --name hive --out out/linux-arm64 bin.mjs",
    "make:darwin-x64": "bare-build --host darwin-x64 --standalone --name hive --out out/darwin-x64 bin.mjs",
    "make:darwin-arm64": "bare-build --host darwin-arm64 --standalone --name hive --out out/darwin-arm64 bin.mjs",
    "make:win32-x64": "bare-build --host win32-x64 --standalone --name hive --out out/win32-x64 bin.mjs",
    "make:win32-arm64": "bare-build --host win32-arm64 --standalone --name hive --out out/win32-arm64 bin.mjs",
    "build": "npm run make"
  },
  "devDependencies": {
    "bare-build": "^1.0.4",
    "brittle": "^4.1.0"
  },
  "dependencies": {
    "hive-agent": "file:packages/hive-agent",
    "hive-auth": "file:packages/hive-auth",
    "hive-cli": "file:packages/hive-cli",
    "hive-core": "file:packages/hive-core",
    "hive-relay": "file:packages/hive-relay",
    "hive-sdk": "file:packages/hive-sdk",
    "hive-store": "file:packages/hive-store",
    "hive-workflow": "file:packages/hive-workflow",
    "bare-runtime": "^1.4.0",
    "@noble/curves": "^2.3.0",
    "@noble/hashes": "^2.3.0",
    "b4a": "^1.8.1",
    "bare-crypto": "^1.15.3",
    "bare-encoding": "^1.0.3",
    "bare-env": "^3.0.1",
    "bare-fs": "^4.8.0",
    "bare-http1": "^4.5.7",
    "bare-https": "^3.0.0",
    "bare-os": "^3.9.3",
    "bare-path": "^3.1.1",
    "bare-process": "^4.5.1",
    "bare-sqlite": "^0.1.4",
    "bare-ws": "^3.0.0",
    "corestore": "^7.12.0",
    "framed-stream": "^1.0.1",
    "graceful-goodbye": "^1.3.3",
    "hyperdht": "^6.33.0",
    "hyperswarm": "^4.17.0",
    "js-yaml": "^5.2.3",
    "paparam": "^1.12.0",
    "pear-runtime": "^1.3.1",
    "protomux": "^3.11.0",
    "ready-resource": "^1.2.0"
  },
  "main": "bin.mjs"
}
